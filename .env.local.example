# MongoDB (use direct connection if DNS SRV fails: see README)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/mod-panel?retryWrites=true&w=majority

# Auth
AUTH_SECRET=change-me-to-32-byte-hex-string
AUTH_REFRESH_SECRET=change-me-to-different-32-byte-hex-string

# FTP
FTP_HOSTNAME=ftpupload.net
FTP_USERNAME=your_ftp_username
FTP_PASSWORD=your_ftp_password
FTP_PORT=21
FTP_REMOTE_PATH=/htdocs/onlinelibs/

# Turnstile (Cloudflare captcha)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxxx

# App
NEXT_PUBLIC_APP_NAME=Mod Panel
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# License key (mod client validation)
LICENSE_KEY=your-license-key

# Encryption (patch key encryption in key-service.ts)
ENCRYPTION_KEY=change-me-to-32-byte-hex-string

# Password legacy salt (for MD5+bcrypt migration compatibility)
PASSWORD_LEGACY_SALT=your-legacy-salt

# Trusted reverse proxy IPs (comma-separated, leave empty if not behind a proxy)
TRUSTED_PROXIES=
